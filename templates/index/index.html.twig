{% extends 'base.html.twig' %}

{% block title %}Ledenoverzicht{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Leden zoeken</h1>
        <p>Zoek op naam, e-mailadres of vaardigheden.</p>
    </section>

    <form method="get" class="search-form">
        <input type="search" name="q" value="{{ query }}" placeholder="Bijv. Symfony of SQL">
        <button type="submit">Zoeken</button>
    </form>

    <section class="cards">
        {% for user in users %}
            <article class="card">
                <h2>{{ user.fullName ?: user.email }}</h2>
                <p><strong>Email:</strong> {{ user.email }}</p>
                <p><strong>Vaardigheden:</strong> {{ user.skills ?: 'Nog niet ingevuld' }}</p>
                <a href="{{ path('app_profile_show', {id: user.id}) }}">Bekijk profiel</a>
            </article>
        {% else %}
            <p>Geen gebruikers gevonden.</p>
        {% endfor %}
    </section>
{% endblock %}
