{% extends 'base.html.twig' %}

{% block title %}Nieuw bericht{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Nieuw bericht</h1>
        <p>Stuur een priv\u00e9bericht naar een andere gebruiker.</p>
    </section>

    <section class="panel">
        {{ form_start(messageForm, {attr: {class: 'stack-form'}}) }}
            {{ form_row(messageForm.recipient, {label: 'Ontvanger'}) }}
            {{ form_row(messageForm.content) }}

            <button type="submit">Versturen</button>
        {{ form_end(messageForm) }}
    </section>
{% endblock %}
