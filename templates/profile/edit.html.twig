{% extends 'base.html.twig' %}

{% block title %}Mijn profiel{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Mijn profiel</h1>
        <p>Werk je naam en vaardigheden bij.</p>
    </section>

    <section class="panel">
        {{ form_start(profileForm, {attr: {class: 'stack-form'}}) }}
            {{ form_row(profileForm.fullName) }}
            {{ form_row(profileForm.skills) }}

            <button type="submit">Opslaan</button>
        {{ form_end(profileForm) }}
    </section>
{% endblock %}
