{% extends 'base.html.twig' %}

{% block title %}Registreren{% endblock %}

{% block body %}
    <section class="auth-card">
        <h1>Registreren</h1>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, {attr: {class: 'stack-form'}}) }}
            {{ form_row(registrationForm.email, {label: 'E-mailadres'}) }}
            {{ form_row(registrationForm.plainPassword, {label: 'Wachtwoord'}) }}
            {{ form_row(registrationForm.agreeTerms, {label: 'Ik ga akkoord met de voorwaarden'}) }}

            <button type="submit">Account aanmaken</button>
        {{ form_end(registrationForm) }}
    </section>
{% endblock %}
